# MyOS backend — environment template
#
# Copy to `.env` (same directory) and edit. `.env` is gitignored; this file is not.
# Every key is optional — the defaults below are what the app uses when the variable
# is absent, so a fresh checkout runs with no configuration at all.
# Never put a real secret in `.env.example`, and never commit `.env`.

# --- storage ---------------------------------------------------------------
# SQLAlchemy URL. Relative SQLite paths are anchored at backend/, so this file
# and `uvicorn app.main:app` always open the same database.
MYOS_DATABASE_URL=sqlite:///./data/myos.db
# Where the SQLite file and ad-hoc exports live (created on demand).
MYOS_DATA_DIR=./data

# --- tenancy & locale ------------------------------------------------------
# Phase 1 runs a single workspace; the slug is resolved (and created) at startup.
MYOS_WORKSPACE=default
MYOS_TIMEZONE=Asia/Kolkata
MYOS_CURRENCY=INR

# --- AI (optional by design; Phase 1 ships rule-based insights only) --------
MYOS_AI_ENABLED=0
# openai | ollama
MYOS_AI_PROVIDER=openai
MYOS_AI_MODEL=gpt-4o-mini
# Override for an OpenAI-compatible gateway or a local Ollama server.
#MYOS_AI_BASE_URL=http://127.0.0.1:11434/v1
# Environment only — never write the key into a file that can be committed.
#MYOS_AI_API_KEY=

# --- behaviour switches ----------------------------------------------------
# Guard for POST /demo/reset: 409 unless this is 1.
MYOS_ALLOW_DEMO_RESET=0
# Dev/test bootstrap: create any missing table at startup. Set 0 where Alembic
# owns the schema (Docker runs `alembic upgrade head` before uvicorn).
MYOS_AUTO_CREATE=1
# Base path of the API; the Next proxy forwards /api/os/* to /api/v1/*.
MYOS_API_PREFIX=/api/v1
