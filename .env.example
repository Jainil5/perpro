# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Client-side variables (exposed to Next.js browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key-here

# Server-side variables (API routes, server actions & background workers)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key-here
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Legacy aliases (supported for backward compatibility)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key-here
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key-here

# ==============================================================================
# AI Providers & Model Configurations
# ==============================================================================

# 1. FreeLLM (Local / Self-hosted endpoint)
FREELLM_BASE_URL=http://localhost:3001/v1
FREELLM_API_KEY=your-freellm-api-key
FREELLM_MODEL=gpt-3.5-turbo

# 2. NVIDIA NIM (Serverless inference)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY_1=your-nvidia-nim-key-1
NVIDIA_API_KEY_2=your-nvidia-nim-key-2
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NIM_MODEL=meta/llama-3.3-70b-instruct

# 3. OpenRouter (Unified multi-provider gateway)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# 4. Direct / Optional Cloud Providers
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Default active model selection
DEFAULT_AI_PROVIDER=freellm
DEFAULT_AI_MODEL=gpt-3.5-turbo

# ==============================================================================
# Security & Authentication
# ==============================================================================
PERSONAL_EXTENSION_TOKEN=your-secure-random-token
CRON_SECRET=your-secure-cron-secret
