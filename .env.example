# ==============================================================================
# Demo Mode
# ==============================================================================
# Set to 1 to run without Supabase or an AI provider: an in-memory seed backs all
# tables and AI calls return offline text. Data resets on restart.
DEMO_MODE=0

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Client-side variables (exposed to Next.js browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key-here

# Server-side variables (API routes, server actions & background workers)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key-here
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Legacy aliases (supported for backward compatibility)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key-here
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key-here

# ==============================================================================
# AI Providers & Model Configurations
# ==============================================================================

# 1. FreeLLM (Local / Self-hosted endpoint)
FREELLM_BASE_URL=http://localhost:3001/v1
FREELLM_API_KEY=your-freellm-api-key
FREELLM_MODEL=gpt-3.5-turbo

# 2. NVIDIA NIM (Serverless inference)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY_1=your-nvidia-nim-key-1
NVIDIA_API_KEY_2=your-nvidia-nim-key-2
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NIM_MODEL=meta/llama-3.3-70b-instruct

# 3. OpenRouter (Unified multi-provider gateway)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# 4. Direct / Optional Cloud Providers
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Default active model selection
DEFAULT_AI_PROVIDER=freellm
DEFAULT_AI_MODEL=gpt-3.5-turbo

# ==============================================================================
# Security & Authentication
# ==============================================================================
PERSONAL_EXTENSION_TOKEN=your-secure-random-token
CRON_SECRET=your-secure-cron-secret

# ==============================================================================
# MyOS (/os) — local-first personal + business operating system
# ==============================================================================
# The Next.js app never talks to the Python service from the browser; the server
# side proxy at /api/os/* forwards to this URL.
MYOS_API_URL=http://127.0.0.1:8000

# Backend settings (read by backend/app/core/config.py, see backend/.env.example)
# Any SQLAlchemy URL works; SQLite is the default so the app runs with zero setup.
MYOS_DATABASE_URL=sqlite:///./data/myos.db
MYOS_DATA_DIR=./data
MYOS_WORKSPACE=default
MYOS_TIMEZONE=Asia/Kolkata
MYOS_CURRENCY=INR

# AI is optional. Everything in MyOS works with this off.
MYOS_AI_ENABLED=0
# openai = any OpenAI-compatible endpoint, ollama = local models
MYOS_AI_PROVIDER=openai
MYOS_AI_BASE_URL=http://localhost:11434/v1
MYOS_AI_MODEL=qwen2.5:14b
MYOS_AI_API_KEY=

# Destructive demo helper: allows POST /api/v1/demo/reset
MYOS_ALLOW_DEMO_RESET=0

# Dev/test bootstrap: create any missing table at startup. Set 0 once Alembic owns
# the schema (the Docker image runs `alembic upgrade head` before uvicorn starts).
MYOS_AUTO_CREATE=1

# Base path the Python service mounts its routers under; the Next proxy forwards
# /api/os/* to this prefix.
MYOS_API_PREFIX=/api/v1

